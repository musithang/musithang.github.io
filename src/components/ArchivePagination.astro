---
---
<section class="pager">
  <span class="pager__info">Page 1 / 6</span>
  <span class="pager__btns">
    <span class="pager__btn pager__btn--active">01</span>
    <span class="pager__btn">02</span>
    <span class="pager__btn">03</span>
    <span class="pager__btn pager__btn--next">Next →</span>
  </span>
</section>

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    background: var(--color-cream);
    border-radius: 14px;
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pager__info {
    color: var(--color-muted2);
  }

  .pager__btns {
    display: flex;
    gap: 6px;
  }

  .pager__btn {
    background: var(--color-ink);
    color: var(--color-cream);
    border-radius: 9px;
    padding: 7px 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .pager__btn--active {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .pager__btn--next {
    background: transparent;
    border: 1.5px solid var(--color-accent);
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
