---
import { getCollection } from 'astro:content';
import Ticker from './Ticker.astro';
import StatusLamps from './StatusLamps.astro';
import { formatDate } from '../lib/utils';

interface Props {
  currentPage?: 'index' | 'archive' | 'post';
}

const { currentPage = 'index' } = Astro.props;

const allPosts = await getCollection('posts');
const holdings = String(allPosts.length).padStart(3, '0');
const cycle = formatDate(new Date());

const tabs = [
  {
    label: 'Index',
    href: '/',
    glyph: 'M12 2.5a9.5 9.5 0 100 19 9.5 9.5 0 000-19M12 7.2l4.2 2.4v4.8L12 16.8l-4.2-2.4V9.6z',
    page: 'index' as const,
  },
  {
    label: 'Archive',
    href: '/archive',
    glyph: 'M4.5 5h15a2.5 2.5 0 012.5 2.5v9a2.5 2.5 0 01-2.5 2.5h-15A2.5 2.5 0 012 16.5v-9A2.5 2.5 0 014.5 5zM8 9a3 3 0 100 6 3 3 0 000-6M16 9a3 3 0 100 6 3 3 0 000-6M11 12h2',
    page: 'archive' as const,
  },
];
---
<header class="header">
  <Ticker holdings={holdings} cycle={cycle} />

  <div class="header__main">
    <a href="/" class="header__brand">
      <svg class="header__mark" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#14120f" stroke-width="1.7">
        <rect x="2.5" y="4.5" width="19" height="15" rx="3.5"></rect>
        <path d="M6 9h6M6 12h9M6 15h4"></path>
        <circle cx="18" cy="9.6" r="1.7" fill="#ff5a30" stroke="none"></circle>
      </svg>
      <span class="header__brand-text">
        <span class="header__brand-name">Musithang</span>
        <span class="header__brand-sub">Data archive · MT·4</span>
      </span>
    </a>

    <nav class="header__nav">
      {tabs.map((tab) => (
        <a
          href={tab.href}
          class:list={['header__tab', { 'header__tab--active': currentPage === tab.page }]}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="flex-shrink:0">
            <path d={tab.glyph}></path>
          </svg>
          <span>{tab.label}</span>
        </a>
      ))}
      <button class="header__retrieve" type="button">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="M11 6.5v9M6.5 11h9"></path>
        </svg>
        <span>Retrieve</span>
      </button>
    </nav>

    <StatusLamps />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-ink);
    color: var(--color-cream);
    padding: 8px 10px;
    border-bottom: 3px solid var(--color-ink);
  }

  .header__main {
    display: flex;
    align-items: stretch;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* Brand */
  .header__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--color-cream);
    color: var(--color-ink);
    border-radius: var(--radius-sm);
    padding: 11px 14px;
    min-width: 0;
    flex: 0 1 auto;
    transition: padding 0.25s ease;
  }

  .header__brand:hover {
    color: var(--color-ink);
  }

  .header__mark {
    flex-shrink: 0;
    transition: all 0.25s ease;
  }

  .header__brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .header__brand-name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118;
    font-weight: 900;
    font-size: 23px;
    line-height: 0.95;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    transition: font-size 0.25s ease;
  }

  .header__brand-sub {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.24em;
    color: var(--color-muted);
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* Navigation */
  .header__nav {
    display: flex;
    align-items: stretch;
    gap: 6px;
    flex: 1 1 260px;
    min-width: 0;
    overflow-x: auto;
    padding: 2px 0;
  }

  .header__tab {
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: var(--radius-xs);
    padding: 0 15px;
    background: transparent;
    color: var(--color-cream);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1.5px solid rgba(239, 233, 221, 0.32);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .header__tab:hover {
    background: rgba(239, 233, 221, 0.1);
    color: var(--color-cream);
  }

  .header__tab--active {
    background: var(--color-accent);
    color: var(--color-ink);
    border-color: var(--color-accent);
  }

  .header__tab--active:hover {
    background: var(--color-accent);
    color: var(--color-ink);
  }

  .header__retrieve {
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: var(--radius-xs);
    padding: 0 15px;
    background: none;
    border: 1.5px solid rgba(239, 233, 221, 0.32);
    color: var(--color-cream);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.15s;
  }

  .header__retrieve:hover {
    background: rgba(239, 233, 221, 0.1);
  }
</style>
