---
import { SITE, NAV } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label={`${SITE.title}, home`}>
      <svg viewBox="0 0 32 20" aria-hidden="true" class="wave">
        <path d="M1 14h5l3-10 4 16 3-12 2 6h13" />
      </svg>
      <span>{SITE.title}</span>
    </a>

    {
      NAV.length > 0 && (
        <nav aria-label="Primary">
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="actions">
      <a class="search-link" href="/search/" id="search-link" aria-label="Search" title="Search (/)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l5 5" /></svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .wordmark {
    margin-right: auto;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
  }

  .wave {
    width: 1.7rem;
    height: auto;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  nav a {
    white-space: nowrap;
  }

  /* Narrow screens: the menu drops to its own row under the wordmark and tools */
  @media (max-width: 34rem) {
    .bar {
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-2);
    }
    nav {
      order: 3;
      flex-basis: 100%;
    }
  }

  .search-link {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .search-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .search-link svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }
</style>

<script>
  // Opens the search modal on click, `/` or Ctrl/Cmd+K. Without JS the link goes to /search/.
  // The small UI module is fetched once the page is idle, so the first keystrokes after `/` are
  // not lost. The Pagefind index and wasm only load when the modal actually opens.
  let searchModule: Promise<typeof import('../scripts/search')> | undefined;
  const load = () => (searchModule ??= import('../scripts/search'));
  const open = async () => (await load()).openSearch();

  if ('requestIdleCallback' in window) requestIdleCallback(() => void load());
  else setTimeout(() => void load(), 1500);

  document.getElementById('search-link')?.addEventListener('click', (event) => {
    if (location.pathname === '/search/') return;
    event.preventDefault();
    void open();
  });

  addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const typing = target?.matches('input, textarea, select, [contenteditable]');
    const mod = event.ctrlKey || event.metaKey;
    const slash = event.key === '/' && !mod && !event.altKey && !typing;
    const shortcut = event.key.toLowerCase() === 'k' && mod;
    if (slash || shortcut) {
      event.preventDefault();
      void open();
    }
  });
</script>
