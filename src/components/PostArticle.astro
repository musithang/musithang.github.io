---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<article class:list={['article', className]}>
  <slot />
</article>

<style>
  .article {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-cream);
    border-radius: var(--radius-lg);
  }

  .article :global(> *) {
    flex: 1 1 auto;
    max-width: 74ch;
    min-width: 0;
    padding: clamp(20px, 3vw, 40px) clamp(16px, 3vw, 36px);
  }

  /* Paragraphs */
  .article :global(p) {
    margin: 0 0 20px;
    font-size: clamp(17px, 1.6vw, 18.5px);
    line-height: 1.72;
    color: #221e18;
  }

  /* Drop cap on first paragraph */
  .article :global(p:first-of-type) {
    margin-top: 0;
  }

  .article :global(p:first-of-type::first-letter) {
    float: left;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100;
    font-weight: 900;
    font-size: 62px;
    line-height: 0.74;
    margin: 6px 11px 0 0;
    color: var(--color-accent);
  }

  /* Headings */
  .article :global(h2) {
    margin: 30px 0 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 110;
    font-weight: 900;
    font-size: clamp(21px, 3vw, 28px);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .article :global(h2::before) {
    content: '';
    display: inline-block;
    width: 18px;
    height: 18px;
    background: var(--color-accent);
    border-radius: 3px;
    flex-shrink: 0;
  }

  .article :global(h3) {
    margin: 24px 0 10px;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 108;
    font-weight: 800;
    font-size: clamp(18px, 2.4vw, 22px);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  /* Blockquotes */
  .article :global(blockquote) {
    margin: 26px 0;
    padding: 18px 22px;
    border-radius: 13px;
    background: var(--color-surface);
    border-left: 6px solid var(--color-accent);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100;
    font-weight: 600;
    font-size: clamp(18px, 2.4vw, 22px);
    line-height: 1.34;
  }

  .article :global(blockquote p) {
    margin: 0;
  }

  /* Lists */
  .article :global(ul),
  .article :global(ol) {
    margin: 0 0 20px;
    padding-left: 1.5em;
  }

  .article :global(li) {
    margin-bottom: 6px;
    font-size: clamp(17px, 1.6vw, 18.5px);
    line-height: 1.72;
    color: #221e18;
  }

  /* Strong / em */
  .article :global(strong) {
    font-weight: 600;
  }

  .article :global(em) {
    font-style: italic;
  }

  /* Code — inline */
  .article :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: rgba(20, 18, 15, 0.08);
    border-radius: 5px;
    padding: 2px 6px;
    word-break: break-word;
  }

  /* Code — block (pre > code) */
  .article :global(pre) {
    margin: 24px 0;
    background: var(--color-ink);
    border-radius: var(--radius-sm);
    padding: 18px 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .article :global(pre code) {
    background: none;
    border-radius: 0;
    padding: 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-cream);
    word-break: normal;
  }

  /* Code — caption / figcaption below code block */
  .article :global(pre + figcaption),
  .article :global(pre + .code-caption) {
    margin-top: -16px;
    padding: 6px 20px 10px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted2);
  }

  /* Links in article */
  .article :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgba(255, 90, 48, 0.3);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  .article :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  /* Horizontal rule */
  .article :global(hr) {
    margin: 32px 0;
    border: none;
    border-top: 2px solid var(--color-ink);
  }

  /* Images */
  .article :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
  }

  /* Tags section at bottom */
  .article :global(.post-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 26px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .article :global(.post-tags span) {
    border: 1.5px solid var(--color-ink);
    border-radius: 9px;
    padding: 6px 11px;
  }
</style>
