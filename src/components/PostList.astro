---
import type { Post } from '../lib/posts';
import PostRow from './PostRow.astro';

interface Props {
  posts: Post[];
  fullDate?: boolean;
  level?: 2 | 3;
}
const { posts, fullDate = false, level = 3 } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => <PostRow post={post} fullDate={fullDate} level={level} />)}
</ul>

<style>
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 52rem;
    border-bottom: 1px solid var(--border);
  }
</style>
