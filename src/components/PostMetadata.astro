---
const meta = [
  { k: 'File no.', v: 'MT·0047', glyph: 'M3 10.8L10.8 3H21v10.2L13.2 21zM16.6 6.5a1 1 0 100 2 1 1 0 000-2' },
  { k: 'Section', v: 'Philosophy', glyph: 'M12 7.4a4.6 4.6 0 100 9.2 4.6 4.6 0 000-9.2M3.2 12c0-2.1 3.9-3.8 8.8-3.8s8.8 1.7 8.8 3.8-3.9 3.8-8.8 3.8S3.2 14.1 3.2 12z' },
  { k: 'Logged', v: '2026·09·12', glyph: 'M12 3.2a8.8 8.8 0 100 17.6 8.8 8.8 0 000-17.6M12 7.6V12l3.4 2.1M12 1.5v1.7' },
  { k: 'Amended', v: '2026·09·13', glyph: 'M2 12h3.2l2.1-6.4 3 12.6 2.6-9.4 1.8 4.4h7.3' },
  { k: 'Length', v: '1,840 words', glyph: 'M4 6h16M6 6v12h12V6M9.5 9.5h5M9.5 13h5M4 18h16' },
  { k: 'Status', v: 'Final(ish)', glyph: 'M3.5 4.5h17v15h-17zM8 9h8v6H8zM12 4.5V9M12 15v4.5M6.5 4.5V2.6M17.5 4.5V2.6' },
];
---
<section class="meta-grid">
  {meta.map((m) => (
    <div class="meta-card">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" style="flex-shrink:0">
        <path d={m.glyph}></path>
      </svg>
      <span class="meta-card__text">
        <span class="meta-card__label">{m.k}</span>
        <span class="meta-card__value">{m.v}</span>
      </span>
    </div>
  ))}
</section>

<style>
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 6px;
  }

  .meta-card {
    background: var(--color-ink);
    color: var(--color-cream);
    border-radius: 12px;
    padding: 11px 14px;
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .meta-card__text {
    min-width: 0;
    font-family: var(--font-mono);
  }

  .meta-card__label {
    display: block;
    font-size: 8.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted2);
  }

  .meta-card__value {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    margin-top: 3px;
  }
</style>
