---
import { render } from 'astro:content';
import { day, type Post } from '../lib/posts';
import KindBadge from './KindBadge.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
  /** Show the year in the date (lists that are not grouped by year). */
  fullDate?: boolean;
  /** Heading level for the title, so lists fit under the page's own headings. */
  level?: 2 | 3;
}

const { post, fullDate = false, level = 3 } = Astro.props;
const Title = `h${level}` as 'h2' | 'h3';
const { remarkPluginFrontmatter: meta } = await render(post);
const iso = day(post.data.date);
---

<li class="row" data-kind={post.data.kind}>
  <time class="mono-label date" datetime={iso}>{fullDate ? iso : iso.slice(5)}</time>
  <div class="body">
    <Title class="title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></Title>
    <p class="desc">{post.data.description}</p>
    <p class="mono-label meta">
      <KindBadge kind={post.data.kind} />
      <span aria-hidden="true">·</span>
      <span>{meta.readingMinutes} min</span>
      {post.data.draft && <span class="draft">[DRAFT]</span>}
    </p>
    <TagList tags={post.data.tags} />
  </div>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .date {
    padding-top: 0.55em;
    white-space: nowrap;
  }
  .title {
    font-size: var(--step-1);
    font-weight: 620;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .desc {
    margin: var(--space-1) 0 var(--space-2);
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: 0 0 var(--space-2);
  }
  .draft {
    color: var(--accent);
    font-weight: 700;
  }
  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .date {
      padding-top: 0;
    }
  }
</style>
