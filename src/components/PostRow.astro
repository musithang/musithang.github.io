---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { day, type Post } from '../lib/posts';
import KindBadge from './KindBadge.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
  /** Show the year in the date (lists that are not grouped by year). */
  fullDate?: boolean;
  /** Heading level for the title, so lists fit under the page's own headings. */
  level?: 2 | 3;
}

const { post, fullDate = false, level = 3 } = Astro.props;
const Title = `h${level}` as 'h2' | 'h3';
const { remarkPluginFrontmatter: meta } = await render(post);
const iso = day(post.data.date);
const cover = post.data.cover;
---

<li class="row" data-kind={post.data.kind} class:list={[{ 'has-cover': Boolean(cover) }]}>
  <time class="mono-label date" datetime={iso}>{fullDate ? iso : iso.slice(5)}</time>
  <div class="body">
    <Title class="title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></Title>
    <p class="desc">{post.data.description}</p>
    <p class="mono-label meta">
      <KindBadge kind={post.data.kind} />
      <span aria-hidden="true">·</span>
      <span>{meta.readingMinutes} min</span>
      {post.data.draft && <span class="draft">[DRAFT]</span>}
    </p>
    <TagList tags={post.data.tags} />
  </div>
  {
    cover && (
      <a class="thumb" href={`/posts/${post.id}/`} aria-hidden="true" tabindex="-1">
        <Image src={cover} alt="" width={640} height={426} fit="cover" position="center" loading="lazy" />
        <span class="thumb-title">{post.data.title}</span>
      </a>
    )
  }
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .row.has-cover {
    grid-template-columns: 5.5rem minmax(0, 1fr) 12rem;
  }
  .date {
    padding-top: 0.55em;
    white-space: nowrap;
  }
  .thumb {
    position: relative;
    display: block;
    align-self: start;
    width: 12rem;
    aspect-ratio: 3 / 2;
    isolation: isolate;
    overflow: hidden;
    background: #20252d;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1rem;
    box-shadow: 0 8px 24px rgb(15 19 24 / 0.16);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  .thumb::after {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(8 12 18 / 0.02) 20%,
      rgb(8 12 18 / 0.18) 48%,
      rgb(8 12 18 / 0.84) 100%
    );
    content: '';
  }
  .thumb-title {
    position: absolute;
    z-index: 1;
    display: -webkit-box;
    right: 0.9rem;
    bottom: 0.85rem;
    left: 0.9rem;
    overflow: hidden;
    color: #fff;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.12;
    text-wrap: balance;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.2);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .thumb:hover {
    border-color: rgb(255 255 255 / 0.5);
    box-shadow: 0 12px 30px rgb(15 19 24 / 0.24);
  }
  .row:has(.title a:focus-visible) .thumb {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .title {
    font-size: var(--step-1);
    font-weight: 620;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .desc {
    margin: var(--space-1) 0 var(--space-2);
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: 0 0 var(--space-2);
  }
  .draft {
    color: var(--accent);
    font-weight: 700;
  }
  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .row.has-cover {
      grid-template-columns: minmax(0, 1fr) 7rem;
      gap: var(--space-2) var(--space-3);
    }
    .row.has-cover .date {
      grid-column: 1 / -1;
    }
    .row.has-cover .body {
      grid-column: 1;
    }
    .row.has-cover .thumb {
      grid-column: 2;
      grid-row: 2;
      width: 7rem;
      aspect-ratio: 3 / 2;
    }
    .row.has-cover .thumb-title {
      right: 0.5rem;
      bottom: 0.55rem;
      left: 0.5rem;
      font-size: var(--step--2);
    }
    .date {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb {
      transition: none;
    }
  }
</style>
