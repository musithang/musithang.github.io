---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { day, type Post } from '../lib/posts';
import KindBadge from './KindBadge.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
  /** Show the year in the date (lists that are not grouped by year). */
  fullDate?: boolean;
  /** Heading level for the title, so lists fit under the page's own headings. */
  level?: 2 | 3;
}

const { post, fullDate = false, level = 3 } = Astro.props;
const Title = `h${level}` as 'h2' | 'h3';
const { remarkPluginFrontmatter: meta } = await render(post);
const iso = day(post.data.date);
const cover = post.data.cover;
---

<li class="row" data-kind={post.data.kind} class:list={[{ 'has-cover': Boolean(cover) }]}>
  <time class="mono-label date" datetime={iso}>{fullDate ? iso : iso.slice(5)}</time>
  <div class="body">
    <Title class="title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></Title>
    <p class="desc">{post.data.description}</p>
    <p class="mono-label meta">
      <KindBadge kind={post.data.kind} />
      <span aria-hidden="true">·</span>
      <span>{meta.readingMinutes} min</span>
      {post.data.draft && <span class="draft">[DRAFT]</span>}
    </p>
    <TagList tags={post.data.tags} />
  </div>
  {
    cover && (
      <a class="thumb" href={`/posts/${post.id}/`} aria-hidden="true" tabindex="-1">
        <Image src={cover} alt="" width={320} height={240} fit="cover" position="center" loading="lazy" />
      </a>
    )
  }
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .row.has-cover {
    grid-template-columns: 5.5rem 1fr 8rem;
  }
  .date {
    padding-top: 0.55em;
    white-space: nowrap;
  }
  .thumb {
    display: block;
    align-self: start;
    width: 8rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.8rem;
    box-shadow: 0 4px 14px rgb(15 19 24 / 0.12);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .row:has(.thumb):hover .thumb {
    border-color: var(--accent);
    box-shadow: 0 8px 22px rgb(15 19 24 / 0.18);
    transform: translateY(-2px);
  }
  .row:has(.thumb):hover .thumb img {
    transform: scale(1.06);
  }
  .row:has(.title a:focus-visible) .thumb {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .title {
    font-size: var(--step-1);
    font-weight: 620;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .desc {
    margin: var(--space-1) 0 var(--space-2);
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: 0 0 var(--space-2);
  }
  .draft {
    color: var(--accent);
    font-weight: 700;
  }
  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .row.has-cover {
      grid-template-columns: 1fr 5.25rem;
      gap: var(--space-2) var(--space-3);
    }
    .row.has-cover .date {
      grid-column: 1 / -1;
    }
    .row.has-cover .body {
      grid-column: 1;
    }
    .row.has-cover .thumb {
      grid-column: 2;
      grid-row: 2;
      width: 5.25rem;
    }
    .date {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb,
    .thumb img {
      transition: none;
    }
  }
</style>
