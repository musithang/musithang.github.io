---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { day, KIND_LABELS, type Post } from '../lib/posts';
import KindBadge from './KindBadge.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
  /** Show the year in the date (lists that are not grouped by year). */
  fullDate?: boolean;
  /** Heading level for the title, so lists fit under the page's own headings. */
  level?: 2 | 3;
}

const { post, fullDate = false, level = 3 } = Astro.props;
const Title = `h${level}` as 'h2' | 'h3';
const { remarkPluginFrontmatter: meta } = await render(post);
const iso = day(post.data.date);
const cover = post.data.cover;
---

<li class="row" data-kind={post.data.kind} class:list={[{ 'has-cover': Boolean(cover) }]}>
  {
    cover && (
      <div class="cover-card">
        <a class="thumb" href={`/posts/${post.id}/`}>
          <Image src={cover} alt="" width={1200} height={600} fit="cover" position="center" loading="lazy" />
          <span class="thumb-shade" aria-hidden="true"></span>
          <span class="thumb-top">
            <span class="thumb-kind">{KIND_LABELS[post.data.kind]}</span>
            <span class="thumb-reading">{meta.readingMinutes} min read</span>
          </span>
          <span class="thumb-bottom">
            <Title class="thumb-title">{post.data.title}</Title>
            <span class="thumb-arrow" aria-hidden="true">↗</span>
          </span>
        </a>
        <div class="cover-content">
          <p class="desc">{post.data.description}</p>
          <p class="cover-date mono-label">
            <time datetime={iso}>{fullDate ? iso : iso.slice(5)}</time>
            {post.data.draft && <span class="draft">[DRAFT]</span>}
          </p>
          <TagList tags={post.data.tags} />
        </div>
      </div>
    )
  }
  {
    !cover && (
      <>
        <time class="mono-label date" datetime={iso}>{fullDate ? iso : iso.slice(5)}</time>
        <div class="body">
          <Title class="title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></Title>
          <p class="desc">{post.data.description}</p>
          <p class="mono-label meta">
            <KindBadge kind={post.data.kind} />
            <span aria-hidden="true">·</span>
            <span>{meta.readingMinutes} min</span>
            {post.data.draft && <span class="draft">[DRAFT]</span>}
          </p>
          <TagList tags={post.data.tags} />
        </div>
      </>
    )
  }
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .row.has-cover {
    display: block;
    padding-block: var(--space-5);
  }
  .date {
    padding-top: 0.55em;
    white-space: nowrap;
  }
  .cover-card {
    width: 100%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 1.2rem;
    box-shadow:
      0 2px 5px rgb(15 19 24 / 0.07),
      0 16px 36px rgb(15 19 24 / 0.1);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 2.2 / 1;
    isolation: isolate;
    overflow: hidden;
    background: #151a20;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .thumb-shade {
    position: absolute;
    z-index: 0;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(8 12 18 / 0.56), transparent 38%),
      linear-gradient(0deg, rgb(8 12 18 / 0.88), rgb(8 12 18 / 0.12) 74%);
    transition: opacity 0.2s ease;
  }
  .thumb-top,
  .thumb-bottom {
    position: absolute;
    z-index: 1;
    right: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .thumb-top {
    top: 0.9rem;
    gap: var(--space-2);
  }
  .thumb-kind {
    padding: 0.3rem 0.55rem;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    background: rgb(15 19 24 / 0.46);
    border: 1px solid rgb(255 255 255 / 0.42);
    border-radius: 999px;
    backdrop-filter: blur(10px);
  }
  .thumb-reading {
    color: rgb(255 255 255 / 0.9);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
  }
  .thumb-bottom {
    bottom: 0.95rem;
    gap: var(--space-3);
  }
  .thumb-title {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #fff;
    font-family: var(--font-serif);
    font-size: clamp(var(--step-2), 3.8vw, var(--step-3));
    font-weight: 680;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.2);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .thumb-arrow {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    place-items: center;
    color: #fff;
    font-size: 1.1rem;
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 50%;
    backdrop-filter: blur(10px);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .cover-card:has(.thumb:hover) {
    border-color: var(--accent);
    box-shadow:
      0 2px 5px rgb(15 19 24 / 0.07),
      0 20px 42px rgb(15 19 24 / 0.16);
  }
  .thumb:hover .thumb-shade {
    opacity: 0.82;
  }
  .thumb:hover .thumb-arrow {
    color: var(--text);
    background: var(--accent);
    border-color: var(--accent);
  }
  .cover-card:has(.thumb:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  .title {
    font-size: var(--step-1);
    font-weight: 620;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .desc {
    margin: var(--space-1) 0 var(--space-2);
    color: var(--muted);
  }
  .cover-content {
    padding: clamp(0.85rem, 2.5vw, 1.2rem);
  }
  .cover-content .desc {
    max-width: 60ch;
    margin: 0;
    color: var(--text);
    font-size: var(--step-0);
    line-height: 1.5;
  }
  .cover-date {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 var(--space-3);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: 0 0 var(--space-2);
  }
  .draft {
    color: var(--accent);
    font-weight: 700;
  }
  @media (max-width: 40rem) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .row.has-cover {
      display: block;
    }
    .row.has-cover .thumb {
      aspect-ratio: 2 / 1;
    }
    .row.has-cover .thumb-top,
    .row.has-cover .thumb-bottom {
      right: 0.8rem;
      left: 0.8rem;
    }
    .row.has-cover .thumb-title {
      font-size: var(--step-1);
    }
    .row.has-cover .thumb-arrow {
      width: 2rem;
      height: 2rem;
    }
    .date {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb {
      transition: none;
    }
  }
</style>
