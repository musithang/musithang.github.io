---
// A thin bar showing how much of the article body has scrolled into view.
---

<div class="progress" id="reading-progress" aria-hidden="true" hidden></div>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
    pointer-events: none;
  }
  @media print {
    .progress {
      display: none;
    }
  }
</style>

<script>
  const bar = document.getElementById('reading-progress');
  const body = document.querySelector<HTMLElement>('article .prose');

  if (bar && body) {
    bar.hidden = false;
    let ticking = false;

    // 0 when the article body starts to enter the viewport, 1 when its end reaches the bottom edge.
    const update = () => {
      ticking = false;
      const rect = body.getBoundingClientRect();
      const progress = (window.innerHeight - rect.top) / rect.height;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
