---
import { slugify, type Post } from '../lib/posts';

interface Props {
  post: Post;
  parts: Post[];
}
const { post, parts } = Astro.props;
const name = post.data.series!;
const position = parts.findIndex((p) => p.id === post.id) + 1;
---

<nav class="series" aria-label={`Series: ${name}`}>
  <p class="mono-label">
    Series · part {position} of {parts.length}
  </p>
  <p class="name"><a href={`/series/${slugify(name)}/`}>{name}</a></p>
  <ol>
    {
      parts.map((part) => (
        <li>
          {part.id === post.id ? (
            <span aria-current="page">{part.data.title}</span>
          ) : (
            <a href={`/posts/${part.id}/`}>{part.data.title}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .series {
    max-width: var(--measure);
    margin-top: var(--space-6);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .mono-label {
    margin: 0;
  }
  .name {
    margin: var(--space-1) 0 var(--space-3);
    font-weight: 650;
  }
  ol {
    margin: 0;
    padding-left: 1.4em;
    font-size: var(--step--1);
  }
  li + li {
    margin-top: var(--space-1);
  }
  [aria-current='page'] {
    font-weight: 650;
  }
</style>
