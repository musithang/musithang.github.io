---
<div class="ticker">
  <div class="ticker__track">
    <span class="ticker__item ticker__item--live">
      <span class="ticker__lamp"></span>
      Systems nominal
    </span>
    <span class="ticker__sep">////</span>
    <span class="ticker__item">Berth MT·4 · sector 07</span>
    <span class="ticker__sep">////</span>
    <span class="ticker__item">Holdings 047</span>
    <span class="ticker__sep">////</span>
    <span class="ticker__item">Cycle 2026·09·16</span>
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    height: 26px;
    transition: height 0.25s ease, opacity 0.2s ease;
  }

  .ticker__track {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 26px;
    padding: 0 4px 0 0;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted2);
    white-space: nowrap;
    overflow: hidden;
  }

  .ticker__item {
    flex-shrink: 0;
  }

  .ticker__item--live {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .ticker__lamp {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: lamp 1.8s ease-in-out infinite;
  }

  .ticker__sep {
    flex-shrink: 0;
    color: var(--color-muted3);
  }
</style>
