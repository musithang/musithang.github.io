---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import ArchiveFilters from '../components/ArchiveFilters.astro';
import ArchiveList from '../components/ArchiveList.astro';
import ArchivePagination from '../components/ArchivePagination.astro';

const segs = Array.from({ length: 16 }, (_, i) => {
  const on = i < 11;
  return on ? (i > 8 ? 'var(--color-accent)' : 'var(--color-cream)') : 'rgba(239,233,221,.2)';
});
---
<ArchiveLayout title="Archive — The Archive" currentPage="archive">
  <main class="archive">
    <section class="archive__hero">
      <div class="archive__hero-label">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
          <rect x="3" y="4" width="18" height="16" rx="3"></rect>
          <path d="M7 9h10M7 13h6"></path>
        </svg>
        Retrieval index · full holdings
      </div>
      <h1 class="archive__hero-title">Archive</h1>
      <p class="archive__hero-desc">Every record, latest cycle first. The tags aren't a taxonomy, they're an admission.</p>
      <div class="archive__segs">
        {segs.map((c) => (
          <span class="archive__seg" style={`background:${c}`}></span>
        ))}
      </div>
    </section>

    <ArchiveFilters />
    <ArchiveList />
    <ArchivePagination />
  </main>
</ArchiveLayout>

<style>
  .archive {
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .archive__hero {
    background: var(--color-ink);
    color: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 3vw, 32px);
    position: relative;
    overflow: hidden;
  }

  .archive__hero-label {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .archive__hero-title {
    margin: 12px 0 12px;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118;
    font-weight: 900;
    font-size: clamp(30px, 7vw, 62px);
    line-height: 0.94;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .archive__hero-desc {
    margin: 0;
    max-width: 54ch;
    font-size: 16px;
    line-height: 1.56;
    color: #c5bcab;
  }

  .archive__segs {
    display: flex;
    gap: 4px;
    margin-top: 20px;
    max-width: 420px;
  }

  .archive__seg {
    flex: 1;
    height: 6px;
    border-radius: 2px;
  }
</style>
