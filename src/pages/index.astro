---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import HeroPanel from '../components/HeroPanel.astro';
import ObservationPanel from '../components/ObservationPanel.astro';
import StatsBar from '../components/StatsBar.astro';
import LatestRecords from '../components/LatestRecords.astro';
import CategoryPanels from '../components/CategoryPanels.astro';
---
<ArchiveLayout title="The Archive" currentPage="index">
  <main class="index">
    <section class="index__hero-row">
      <HeroPanel />
      <ObservationPanel />
    </section>
    <StatsBar />
    <LatestRecords />
    <CategoryPanels />
  </main>
</ArchiveLayout>

<style>
  .index {
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .index__hero-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
