---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { getPosts, getProjects } from '../lib/posts';

const [posts, projects] = await Promise.all([getPosts(), getProjects()]);
const latest = posts.slice(0, 5);
const featured = projects.find((p) => p.id === 'sdrtop') ?? projects[0];
---

<Base>
  <header class="hero">
    <p class="mono-label">Bench log</p>
    <h1>Notes from the bench</h1>
    <p class="lede">{SITE.description}</p>
  </header>

  <section aria-labelledby="latest">
    <h2 id="latest" class="section-title">Latest</h2>
    {
      latest.length === 0 ? (
        <p class="empty">Nothing here yet. The bench is clean, which is rare and won't last.</p>
      ) : (
        <>
          <PostList posts={latest} fullDate />
          <p class="more mono-label">
            <a href="/posts/">All posts →</a>
          </p>
        </>
      )
    }
  </section>

  {
    featured && (
      <section class="featured" aria-labelledby="featured">
        <h2 id="featured" class="section-title">
          Main project
        </h2>
        <div class="card">
          <h3>
            <a href={`/projects/${featured.id}/`}>{featured.data.name}</a>
          </h3>
          <p>{featured.data.tagline}</p>
          <p class="mono-label">
            <a href={`/projects/${featured.id}/`}>Devlog →</a>
            <span aria-hidden="true"> · </span>
            <a href={featured.data.repo}>Source ↗</a>
          </p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
  }
  .hero .mono-label {
    margin: 0 0 var(--space-3);
  }
  .lede {
    margin: var(--space-4) 0 0;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--muted);
  }
  .section-title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .empty {
    color: var(--muted);
  }
  .more {
    margin-top: var(--space-4);
  }
  .featured {
    margin-top: var(--space-8);
  }
  .card {
    max-width: 52rem;
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .card h3 {
    font-size: var(--step-2);
  }
  .card h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .card h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .card p {
    margin: var(--space-2) 0 0;
  }
</style>
