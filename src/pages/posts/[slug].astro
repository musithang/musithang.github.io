---
import { render } from 'astro:content';
import katexCss from 'katex/dist/katex.min.css?url';
import Base from '../../layouts/Base.astro';
import KindBadge from '../../components/KindBadge.astro';
import TagList from '../../components/TagList.astro';
import StaleBanner from '../../components/StaleBanner.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import PostNav from '../../components/PostNav.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import Toc from '../../components/Toc.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { absoluteUrl } from '../../lib/site';
import { SITE } from '../../config';
import { day, getPosts, getProjects, neighbours, relatedPosts, seriesMap, slugify, staleMonths } from '../../lib/posts';
import '../../styles/post.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const [all, projects] = await Promise.all([getPosts(), getProjects()]);
const { Content, headings, remarkPluginFrontmatter: meta } = await render(post);
const { title, description, date, updated, kind, tags, draft, series, toc } = post.data;

const project = projects.find((p) => p.id === post.data.project?.id);
const stale = staleMonths(post);
const parts = series ? (seriesMap(all).get(slugify(series))?.parts ?? []) : [];
const { prev, next } = neighbours(post, all);
const related = relatedPosts(post, all);
---

<Base
  title={title}
  description={description}
  type="article"
  image={`/og/${post.id}.png`}
  published={date}
  modified={updated ?? date}
  tags={tags}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    author: { '@type': 'Person', name: SITE.author, url: absoluteUrl('/about/') },
    mainEntityOfPage: absoluteUrl(`/posts/${post.id}/`),
    image: absoluteUrl(`/og/${post.id}.png`),
    keywords: tags.join(', '),
    inLanguage: SITE.lang,
  }}
>
  {meta.hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}

  <ReadingProgress />

  <article class="post" data-pagefind-body>
    {stale !== null && <StaleBanner months={stale} />}

    <header class="post-head">
      <p class="mono-label meta" data-pagefind-ignore>
        <time datetime={day(date)} data-pagefind-meta="date[datetime]">{day(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{meta.readingMinutes} min read</span>
        <span aria-hidden="true">·</span>
        <KindBadge kind={kind} />
        {project && (
          <>
            <span aria-hidden="true">·</span>
            <a href={`/projects/${project.id}/`}>{project.data.name}</a>
          </>
        )}
        {draft && <span class="draft">[DRAFT]</span>}
      </p>
      <h1 data-pagefind-meta="title">{title}</h1>
      <p class="lede" data-pagefind-meta="description">{description}</p>
      {
        updated && (
          <p class="mono-label revised">
            Revised <time datetime={day(updated)}>{day(updated)}</time>
          </p>
        )
      }
      <TagList tags={tags} />
    </header>

    <span hidden data-pagefind-ignore data-pagefind-filter="kind">{kind}</span>
    {tags.map((tag) => <span hidden data-pagefind-ignore data-pagefind-filter="tag">{tag}</span>)}

    {toc && <Toc headings={headings} />}

    <div class="prose">
      <Content />
    </div>

    {parts.length > 1 && <SeriesNav post={post} parts={parts} />}
    <PostNav prev={prev} next={next} inSeries={parts.length > 1} />
    <RelatedPosts posts={related} />
  </article>
</Base>

<script>
  import '../../scripts/mermaid';
  import '../../scripts/lightbox';
  import '../../scripts/a11y';
</script>

<style>
  /* One column on small screens; from 72rem the TOC (see Toc.astro) takes a right-hand column. */
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .post > :global(*) {
    grid-column: 1;
  }
  @media (min-width: 72rem) {
    .post {
      grid-template-columns: minmax(0, var(--measure)) 15rem;
      column-gap: var(--space-8);
    }
    .post > :global(.toc-col) {
      grid-column: 2;
    }
  }

  .post-head {
    max-width: var(--measure);
    margin-bottom: var(--space-7);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: 0 0 var(--space-4);
  }

  .meta a {
    color: var(--muted);
  }

  .meta a:hover {
    color: var(--accent);
  }

  .draft {
    color: var(--accent);
    font-weight: 700;
  }

  h1 {
    margin-bottom: var(--space-4);
  }

  .lede {
    margin: 0 0 var(--space-4);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--muted);
  }

  .revised {
    margin: 0 0 var(--space-3);
  }
</style>
