---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getPosts, getProjects } from '../../lib/posts';

const [projects, posts] = await Promise.all([getProjects(), getPosts()]);
const count = (id: string) => posts.filter((p) => p.data.project?.id === id).length;
---

<Base title="Projects" description="Things I build, and the logs that go with them.">
  <PageHead
    eyebrow="Projects"
    title="Things I build"
    lede="Each project keeps its own devlog, so you can follow the dead ends as well as the releases."
  />
  <ul class="grid">
    {
      projects.map((project) => (
        <li class="card">
          <h2>
            <a href={`/projects/${project.id}/`}>{project.data.name}</a>
          </h2>
          <p>{project.data.tagline}</p>
          <p class="mono-label">
            {count(project.id)} {count(project.id) === 1 ? 'post' : 'posts'}
          </p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  h2 {
    font-size: var(--step-2);
  }
  h2 a {
    color: var(--text);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  p {
    margin: var(--space-2) 0 0;
  }
</style>
