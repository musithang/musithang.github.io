---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
---
<ArchiveLayout title="Retrieve — The Archive" currentPage="retrieve">
  <main class="retrieve">
    <section class="retrieve__panel">
      <div class="retrieve__label">Retrieve</div>
      <h1 class="retrieve__title">Search the holdings</h1>

      <div class="retrieve__field">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="M11 6.5v9M6.5 11h9"></path>
        </svg>
        <input
          id="retrieve-input"
          type="text"
          placeholder="Search record titles and text…"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <p id="retrieve-status" class="retrieve__status"></p>
      <div id="retrieve-results" class="retrieve__results"></div>
    </section>
  </main>
</ArchiveLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#retrieve-input');
  const resultsEl = document.querySelector<HTMLDivElement>('#retrieve-results');
  const statusEl = document.querySelector<HTMLParagraphElement>('#retrieve-status');

  let pagefind: any;
  let debounceTimer: ReturnType<typeof setTimeout>;

  async function ensurePagefind() {
    if (!pagefind) {
      // Resolved at runtime from the built pagefind index, not by Vite or TS.
      // @ts-ignore
      pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
      await pagefind.init();
    }
    return pagefind;
  }

  async function runSearch(query: string) {
    if (!resultsEl || !statusEl) return;

    if (!query) {
      resultsEl.innerHTML = '';
      statusEl.textContent = '';
      return;
    }

    statusEl.textContent = 'Searching…';

    try {
      const pf = await ensurePagefind();
      const search = await pf.search(query);
      const items = await Promise.all(search.results.slice(0, 20).map((r: any) => r.data()));

      if (items.length === 0) {
        resultsEl.innerHTML = '';
        statusEl.textContent = 'No matches.';
        return;
      }

      statusEl.textContent = `${items.length} match${items.length === 1 ? '' : 'es'}`;
      resultsEl.innerHTML = items
        .map(
          (item: any) => `
        <a class="retrieve__result" href="${item.url}">
          <div class="retrieve__result-title">${item.meta?.title ?? item.url}</div>
          <div class="retrieve__result-excerpt">${item.excerpt}</div>
        </a>
      `
        )
        .join('');
    } catch {
      statusEl.textContent = 'Search index unavailable in dev — build and preview to search.';
      resultsEl.innerHTML = '';
    }
  }

  input?.addEventListener('input', (e) => {
    clearTimeout(debounceTimer);
    const value = (e.target as HTMLInputElement).value.trim();
    debounceTimer = setTimeout(() => runSearch(value), 150);
  });

  input?.focus();
</script>

<style>
  .retrieve {
    padding: 10px;
  }

  .retrieve__panel {
    background: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 3vw, 34px);
    max-width: 74ch;
  }

  .retrieve__label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted2);
  }

  .retrieve__title {
    margin: 12px 0 22px;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118;
    font-weight: 900;
    font-size: clamp(28px, 5vw, 44px);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .retrieve__field {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--color-bg);
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    color: var(--color-ink);
  }

  .retrieve__field input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }

  .retrieve__field input::placeholder {
    color: var(--color-muted2);
  }

  .retrieve__status {
    margin: 14px 2px 0;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted2);
    min-height: 1em;
  }

  .retrieve__results {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
  }

  .retrieve__result {
    display: block;
    padding: 14px 2px;
    border-bottom: 1px solid rgba(20, 18, 15, 0.12);
  }

  .retrieve__result:hover .retrieve__result-title {
    color: var(--color-accent);
  }

  .retrieve__result-title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 112;
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .retrieve__result-excerpt {
    margin-top: 4px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--color-body);
  }

  .retrieve__result-excerpt :global(mark) {
    background: none;
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
