---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, tagCounts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagCounts(posts).map(({ tag }) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <PageHead
    eyebrow="Tag"
    title={`#${tag}`}
    lede={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}.`}
  />
  <PostList posts={posts} fullDate level={2} />
  <p class="back mono-label"><a href="/tags/">← All tags</a></p>
</Base>

<style>
  .back {
    margin-top: var(--space-5);
  }
  a {
    color: var(--accent);
  }
</style>
